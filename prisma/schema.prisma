generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  AGENT
  ADMIN
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RequestStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PENDING_APPROVAL
  APPROVED
  AGENT_ASSIGNED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PROOF_UPLOADED
  UNDER_VERIFICATION
  VERIFIED
  REJECTED
  REFUND_PENDING
  REFUNDED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum AvailabilityType {
  WORKING_HOURS
  UNAVAILABLE
  DAY_OFF
}

enum PricingType {
  FIXED
  CUSTOM_QUOTE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum EvidenceType {
  PAYMENT_PROOF
  COMPLETION_DOCUMENT
  QUEUE_REFERENCE
  OTHER
}

model User {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  email           String        @unique
  mobile          String        @unique
  passwordHash    String
  fullName        String
  role            UserRole      @default(CUSTOMER)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  customerProfile  CustomerProfile?
  agentProfile     AgentProfile?
  sessions         Session[]
  passwordResets   PasswordReset[]
  requests         ServiceRequest[] @relation("CustomerRequests")
  notifications    Notification[]
  auditLogs        AuditLog[]       @relation("AuditActor")
  verifiedPayments Payment[]        @relation("PaymentVerifier")
  internalNotes    RequestNote[]
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique
  csrfHash  String
  userId    String   @db.ObjectId
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordReset {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  userId    String    @db.ObjectId
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CustomerProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  altMobile String?
  address   String?
  city      String   @default("Gaborone")
  termsAt   DateTime
  privacyAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentProfile {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  userId             String              @unique @db.ObjectId
  agentReference     String              @unique
  emergencyContact   String?
  onboardingComplete Boolean             @default(false)
  available          Boolean             @default(false)
  hourlyRate         Float               @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability       AgentAvailability[]
  assignments        AgentAssignment[]
  earnings           AgentEarning[]
}

model Institution {
  id                       String                  @id @default(auto()) @map("_id") @db.ObjectId
  name                     String
  slug                     String                  @unique
  address                  String
  city                     String                  @default("Gaborone")
  contactPhone             String?
  contactEmail             String?
  description              String?
  active                   Boolean                 @default(false)
  actualCustomerRequired   Boolean                 @default(false)
  requiredAuthorisation    String?
  restrictions             String?
  estimatedDurationMinutes Int                     @default(120)
  internalNotes            String?
  lastPermissionReviewAt   DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  deletedAt                DateTime?
  permissions              InstitutionPermission[]
  requests                 ServiceRequest[]

  @@index([active, city])
}

model InstitutionPermission {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  institutionId String      @db.ObjectId
  serviceTypeId String      @db.ObjectId
  permitted     Boolean     @default(false)
  conditions    String?
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@unique([institutionId, serviceTypeId])
}

model ServiceType {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String                  @unique
  description  String?
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  permissions  InstitutionPermission[]
  pricingRules PricingRule[]
  requests     ServiceRequest[]
}

model PricingRule {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  serviceTypeId String           @db.ObjectId
  type          PricingType      @default(FIXED)
  amount        Float?
  currency      String           @default("BWP")
  criteria      Json?
  active        Boolean          @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  serviceType   ServiceType      @relation(fields: [serviceTypeId], references: [id])
  requests      ServiceRequest[]

  @@index([serviceTypeId, active, effectiveFrom])
}

model ServiceRequest {
  id                       String        @id @default(auto()) @map("_id") @db.ObjectId
  reference                String        @unique
  customerId               String        @db.ObjectId
  institutionId            String        @db.ObjectId
  serviceTypeId            String        @db.ObjectId
  pricingRuleId            String?       @db.ObjectId
  requestedDate            DateTime
  preferredArrivalTime     String
  scheduledStartAt         DateTime
  estimatedDurationMinutes Int
  locationInstructions     String?
  assistanceFor            String        @default("SELF")
  instructions             String?
  contactName              String
  contactMobile            String
  alternativeMobile        String?
  contactEmail             String
  onSiteContact            String?
  quotedAmount             Float
  currency                 String        @default("BWP")
  requestStatus            RequestStatus @default(PENDING_PAYMENT)
  paymentStatus            PaymentStatus @default(UNPAID)
  termsAcceptedAt          DateTime
  rejectionReason          String?
  cancellationReason       String?
  refundEligible           Boolean?
  approvedAt               DateTime?
  completedAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  deletedAt                DateTime?

  customer      User              @relation("CustomerRequests", fields: [customerId], references: [id])
  institution   Institution       @relation(fields: [institutionId], references: [id])
  serviceType   ServiceType       @relation(fields: [serviceTypeId], references: [id])
  pricingRule   PricingRule?      @relation(fields: [pricingRuleId], references: [id])
  payments      Payment[]
  assignments   AgentAssignment[]
  taskUpdates   TaskUpdate[]
  evidence      TaskEvidence[]
  notifications Notification[]
  review        Review?
  refund        Refund?
  notes         RequestNote[]

  @@index([customerId, createdAt])
  @@index([requestStatus, paymentStatus])
  @@index([institutionId, scheduledStartAt])
}

model Payment {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  requestId         String         @db.ObjectId
  amountExpected    Float
  amountSubmitted   Float?
  currency          String         @default("BWP")
  paymentReference  String?
  status            PaymentStatus  @default(UNPAID)
  verificationNotes String?
  verifiedById      String?        @db.ObjectId
  verifiedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  request           ServiceRequest @relation(fields: [requestId], references: [id])
  verifiedBy        User?          @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  proofs            PaymentProof[]

  @@index([requestId, status])
}

model PaymentProof {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentId    String   @db.ObjectId
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedAt   DateTime @default(now())
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model AgentAvailability {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  agentId   String           @db.ObjectId
  type      AvailabilityType
  startsAt  DateTime
  endsAt    DateTime
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  agent     AgentProfile     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, startsAt, endsAt])
}

model AgentAssignment {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  requestId           String           @db.ObjectId
  agentId             String           @db.ObjectId
  status              AssignmentStatus @default(ASSIGNED)
  scheduledStartAt    DateTime
  scheduledEndAt      DateTime
  travelBufferMinutes Int              @default(30)
  overrideReason      String?
  assignedById        String           @db.ObjectId
  acceptedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  request             ServiceRequest   @relation(fields: [requestId], references: [id])
  agent               AgentProfile     @relation(fields: [agentId], references: [id])
  taskUpdates         TaskUpdate[]
  evidence            TaskEvidence[]
  earnings            AgentEarning[]

  @@index([agentId, scheduledStartAt, scheduledEndAt])
  @@index([requestId, status])
}

model TaskUpdate {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  requestId    String           @db.ObjectId
  assignmentId String?          @db.ObjectId
  status       AssignmentStatus
  message      String?
  publicNote   String?
  actorId      String           @db.ObjectId
  createdAt    DateTime         @default(now())
  request      ServiceRequest   @relation(fields: [requestId], references: [id])
  assignment   AgentAssignment? @relation(fields: [assignmentId], references: [id])

  @@index([requestId, createdAt])
}

model TaskEvidence {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  requestId          String           @db.ObjectId
  assignmentId       String?          @db.ObjectId
  type               EvidenceType
  storageKey         String?
  permittedReference String?
  outcome            String?
  mimeType           String?
  sizeBytes          Int?
  createdAt          DateTime         @default(now())
  request            ServiceRequest   @relation(fields: [requestId], references: [id])
  assignment         AgentAssignment? @relation(fields: [assignmentId], references: [id])
}

model Notification {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  userId         String              @db.ObjectId
  requestId      String?             @db.ObjectId
  channel        NotificationChannel
  event          String
  title          String
  message        String
  deliveryStatus DeliveryStatus      @default(PENDING)
  failureDetail  String?
  readAt         DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  request        ServiceRequest?     @relation(fields: [requestId], references: [id])

  @@index([userId, readAt, createdAt])
}

model NotificationTemplate {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  event     String
  channel   NotificationChannel
  subject   String?
  body      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([event, channel])
}

model Review {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  requestId String         @unique @db.ObjectId
  rating    Int
  comment   String?
  approved  Boolean        @default(false)
  createdAt DateTime       @default(now())
  request   ServiceRequest @relation(fields: [requestId], references: [id])
}

model Refund {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  requestId   String         @unique @db.ObjectId
  amount      Float
  status      RefundStatus   @default(PENDING)
  reason      String
  processedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  request     ServiceRequest @relation(fields: [requestId], references: [id])
}

model AgentEarning {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  agentId      String          @db.ObjectId
  assignmentId String          @db.ObjectId
  amount       Float
  currency     String          @default("BWP")
  paidAt       DateTime?
  createdAt    DateTime        @default(now())
  agent        AgentProfile    @relation(fields: [agentId], references: [id])
  assignment   AgentAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([agentId, assignmentId])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?  @db.ObjectId
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?
  sensitive   Boolean  @default(false)
  updatedById String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemCounter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model RequestNote {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  requestId String         @db.ObjectId
  authorId  String         @db.ObjectId
  content   String
  createdAt DateTime       @default(now())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
}

model AgentScheduleLock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  agentId   String   @unique @db.ObjectId
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}
