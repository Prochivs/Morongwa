FROM node:22-alpine AS base
WORKDIR /app
COPY package*.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

FROM base AS development
ENV NODE_ENV=development
EXPOSE 3000
CMD ["npm", "run", "dev", "-w", "@queuemate/web"]

FROM base AS builder
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build -w @queuemate/shared && npm run build -w @queuemate/web

FROM node:22-alpine AS production
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S nodejs && adduser -S queuemate -G nodejs && apk add --no-cache wget
COPY --from=builder --chown=queuemate:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=queuemate:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=queuemate:nodejs /app/apps/web/public ./apps/web/public
USER queuemate
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
